<core:FragmentDefinition
	xmlns="sap.ui.comp.valuehelpdialog"
	xmlns:m="sap.m"
	xmlns:fb="sap.ui.comp.filterbar"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	xmlns:mvc="sap.ui.core.mvc">

    <ValueHelpDialog
        id="valueHelpDialog"
        title="Value Help"
        supportMultiselect="false"
        stretch="false"
        ok=".onValueHelpDialogOk"
        cancel=".onValueHelpDialogCancel"
        afterClose=".onValueHelpDialogAfterClose">
        <fb:FilterBar
            id="valueHelpFilterBar"
            search=".onValueHelpDialogSearch"
            header="Filter"
            class="sapUiSmallMarginBottom sapUIBorderRadius"
            visible="true">
            <fb:filterGroupItems>
                <fb:FilterGroupItem
                    id="valueHelpFilterGroupItem"
                    visibleInFilterBar="true"
                    name="valueHelpFilter"
                    label="Value"
                    groupName="Group1">
                    <fb:control>
                        <m:Input id="valueHelpFilterInput" width="100%"/>
                    </fb:control>
                </fb:FilterGroupItem>
            </fb:filterGroupItems>
        </fb:FilterBar>
        <m:Table
            id="valueHelpTable"
            width="auto"
            items="{/ValueHelpData}">
            <m:columns>
                <m:Column id="valueHelpColumn">
                    <m:Text id="valueHelpColumnText" text="Value"/>
                </m:Column>
            </m:columns>
            <m:items>
                <m:ColumnListItem id="valueHelpTableItem" type="Active">
                    <m:cells>
                        <m:Text id="valueHelpText" text="{value}"/>
                    </m:cells>
                </m:ColumnListItem>
            </m:items>
        </m:Table>
    </ValueHelpDialog>
</core:FragmentDefinition>